@model MathematicsLessons.Models.TeacherDashboard
@{ ViewData["Title"] = "Учител"; }
<h1 class="h3 mb-3">Табло учител</h1>
<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card-soft p-3"><div class="text-muted small">Ученици</div><div class="fs-4">@Model.TotalStudents</div></div></div>
    <div class="col-md-4"><div class="card-soft p-3"><div class="text-muted small">Без видео</div><div class="fs-4">@Model.LessonsWithoutVideo</div></div></div>
    <div class="col-md-4"><div class="card-soft p-3"><div class="text-muted small">Предстоящи букинги</div><div class="fs-4">@Model.UpcomingBookings</div></div></div>
</div>
<a class="btn btn-primary" asp-controller="CourseAdmin" asp-action="Index">Управление на курсове</a>
