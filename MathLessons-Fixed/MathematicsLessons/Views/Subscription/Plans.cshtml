@model List<MathematicsLessons.Infrastructure.Data.Entities.Sub>
@{
    ViewData["Title"] = "Subscription";
    var isSubscriber = ViewBag.IsSubscriber as bool? ?? false;
    var loggedIn = ViewBag.IsLoggedIn as bool? ?? false;
}
<h1 class="page-title">Subscription plans</h1>
<p class="page-lead">
    Free includes the first Beginner lesson. Math Enthusiast unlocks all courses and private lessons.
</p>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-warning">
        No plans in the database yet.
        @if (User.IsInRole("Admin"))
        {
            <span>Go to Admin → <strong>Load demo courses + prices</strong>.</span>
        }
        else
        {
            <span>Please ask the administrator to load the price plans.</span>
        }
    </div>
}
else
{
    <div class="row">
    @foreach (var plan in Model.OrderBy(p => p.PricePerMonth))
    {
        var isFree = plan.PricePerMonth <= 0 && plan.Type.Contains("Free", StringComparison.OrdinalIgnoreCase);
        var featured = !isFree;
        <div class="col-md-6 mb-4">
            <div class="card h-100 @(featured ? "plan-featured" : "")">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h2 class="h5 mb-0">@plan.Type</h2>
                        @if (isFree)
                        {
                            <span class="badge-soft">Free</span>
                        }
                        else
                        {
                            <span class="badge-soft">Popular</span>
                        }
                    </div>
                    <p class="text-muted small mb-3">@plan.Description</p>
                    <div class="mb-3">
                        @if (isFree)
                        {
                            <div class="h3 mb-0">0.00 <small class="text-muted">BGN</small></div>
                            <div class="small text-muted">No monthly fee</div>
                        }
                        else
                        {
                            <div class="h3 mb-0">@plan.PricePerMonth.ToString("0.00") <small class="text-muted">BGN / month</small></div>
                            <div class="small text-muted">or @plan.PricePerYear.ToString("0.00") BGN / year</div>
                        }
                    </div>
                    <ul class="small text-muted mb-4 pl-3">
                        @if (isFree)
                        {
                            <li>First Beginner lesson</li>
                            <li>Account &amp; progress tracking</li>
                        }
                        else
                        {
                            <li>All courses (Beginner → College)</li>
                            <li>Private lesson booking</li>
                            @if (plan.IncludesPrivateSessions)
                            {
                                <li>Up to @plan.MaxSessionsPerMonth private sessions / month</li>
                            }
                        }
                    </ul>
                    <div class="mt-auto">
                    @if (!loggedIn)
                    {
                        <a class="btn btn-primary btn-block" asp-area="Identity" asp-page="/Account/Register">Register</a>
                    }
                    else if (isSubscriber && !isFree)
                    {
                        <button class="btn btn-outline-secondary btn-block" disabled>Current plan</button>
                    }
                    else if (isFree)
                    {
                        <a class="btn btn-outline-secondary btn-block" asp-controller="Classroom" asp-action="Index">Go to courses</a>
                    }
                    else
                    {
                        <a class="btn btn-primary btn-block"
                           asp-action="Checkout" asp-route-planId="@plan.Id">Subscribe</a>
                    }
                    </div>
                </div>
            </div>
        </div>
    }
    </div>
}
