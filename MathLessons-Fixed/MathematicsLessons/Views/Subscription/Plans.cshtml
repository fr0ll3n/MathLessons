@model List<MathematicsLessons.Infrastructure.Data.Entities.Sub>
@{
    ViewData["Title"] = "Абонамент";
    var isSubscriber = ViewBag.IsSubscriber as bool? ?? false;
    var loggedIn = ViewBag.IsLoggedIn as bool? ?? false;
    var plan = Model.FirstOrDefault(p => p.Type.Contains("Enthusiast") || p.Type == "Subscriber" || p.IncludesPrivateSessions)
               ?? Model.OrderByDescending(p => p.PricePerMonth).FirstOrDefault();
}
<div class="text-center mb-5">
  <p class="text-uppercase small text-muted letter-spacing mb-2">Pricing</p>
  <h1 class="h2 fw-bold">Free или Math Enthusiast</h1>
  <p class="text-muted mx-auto" style="max-width:28rem">Започни безплатно. Отключи всички курсове и частни уроци с Math Enthusiast.</p>
</div>

@if (isSubscriber)
{
  <div class="alert alert-success text-center">Ти си <strong>Math Enthusiast</strong> — пълен достъп.</div>
}

<div class="row g-4 justify-content-center">
  <div class="col-md-5">
    <div class="card plan-card h-100 shadow-sm border-0">
      <div class="card-body p-4 d-flex flex-column">
        <h2 class="h4 fw-bold">Free</h2>
        <p class="text-muted small flex-grow-1">За да видиш как работи платформата.</p>
        <div class="display-5 fw-bold mb-1">0 <span class="fs-5 text-muted">лв</span></div>
        <div class="small text-muted mb-4">завинаги безплатно</div>
        <ul class="list-unstyled small mb-4">
          <li class="mb-2"><i class="bi bi-check2 text-success me-1"></i> Регистрация и профил</li>
          <li class="mb-2"><i class="bi bi-check2 text-success me-1"></i> 1 урок от Beginner</li>
          <li class="mb-2"><i class="bi bi-x text-muted me-1"></i> Останалите курсове заключени</li>
          <li class="mb-2"><i class="bi bi-x text-muted me-1"></i> Без частен урок</li>
        </ul>
        @if (!loggedIn)
        {
          <a class="btn btn-outline-primary w-100" asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
        }
        else if (!isSubscriber)
        {
          <button type="button" class="btn btn-outline-secondary w-100" disabled>Текущ план</button>
        }
      </div>
    </div>
  </div>

  @if (plan != null)
  {
    var year = plan.PricePerYear > 0 ? plan.PricePerYear : plan.PricePerMonth * 10;
    <div class="col-md-5">
      <div class="card plan-card featured h-100">
        <div class="bg-primary text-white text-center py-2 small fw-semibold">Препоръчан · Math Enthusiast</div>
        <div class="card-body p-4 d-flex flex-column">
          <h2 class="h4 fw-bold">Math Enthusiast</h2>
          <p class="text-muted small flex-grow-1">@plan.Description</p>
          <div class="display-5 fw-bold text-primary mb-1">
            @plan.PricePerMonth.ToString("0")
            <span class="fs-5 text-muted">лв/мес</span>
          </div>
          <div class="small text-muted mb-4">или @year.ToString("0") лв/год</div>
          <ul class="list-unstyled small mb-4">
            <li class="mb-2"><i class="bi bi-check2 text-success me-1"></i> Всички курсове Beginner → College</li>
            <li class="mb-2"><i class="bi bi-check2 text-success me-1"></i> Упражнения и прогрес</li>
            <li class="mb-2"><i class="bi bi-check2 text-success me-1"></i> До @plan.MaxSessionsPerMonth частни сесии/мес</li>
            <li class="mb-2"><i class="bi bi-check2 text-success me-1"></i> Discord Q&amp;A</li>
            <li class="mb-2"><i class="bi bi-check2 text-success me-1"></i> Сертификати при 100% ниво</li>
          </ul>
          @if (!loggedIn)
          {
            <a class="btn btn-primary w-100" asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
          }
          else if (isSubscriber)
          {
            <button type="button" class="btn btn-outline-secondary w-100" disabled>Активен</button>
          }
          else
          {
            <div class="d-grid gap-2">
              <form asp-action="Choose" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="planId" value="@plan.Id" />
                <input type="hidden" name="billingCycle" value="Monthly" />
                <button type="submit" class="btn btn-primary w-100">Месечно</button>
              </form>
              <form asp-action="Choose" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="planId" value="@plan.Id" />
                <input type="hidden" name="billingCycle" value="Annual" />
                <button type="submit" class="btn btn-outline-primary w-100">Годишно — по-изгодно</button>
              </form>
            </div>
          }
        </div>
      </div>
    </div>
  }
</div>
