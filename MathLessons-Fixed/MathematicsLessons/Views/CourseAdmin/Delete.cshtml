@model MathematicsLessons.Infrastructure.Data.Entities.Level
@{ ViewData["Title"] = "Delete course"; }
<h1>Delete @Model.Name?</h1>
<p>Sections: @Model.Topics.Count · Lessons: @Model.Lessons.Count</p>
<form asp-action="Delete" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><button type="submit" class="btn btn-danger">Delete</button></form>
<a asp-action="Index">Cancel</a>
