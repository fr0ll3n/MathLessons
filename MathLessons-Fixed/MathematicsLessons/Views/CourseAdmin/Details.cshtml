@model MathematicsLessons.Infrastructure.Data.Entities.Level
@{ ViewData["Title"] = Model.Name; }
<h1>@Model.Name <small>(@Model.GradeRange)</small></h1>
<p>@Model.Description</p>
<p>
<a asp-action="Edit" asp-route-id="@Model.Id">Edit course</a> |
<a asp-action="Sections" asp-route-courseId="@Model.Id">Manage sections</a> |
<a asp-action="CreateSection" asp-route-courseId="@Model.Id">Add section</a> |
<a asp-action="Index">Back</a>
</p>
@foreach (var s in Model.Topics.OrderBy(t => t.SortOrder)) {
  <h3>@s.Name</h3>
  <ul>
  @foreach (var l in s.Lessons.OrderBy(x => x.SortOrder)) {
    <li>@l.Title — @l.Exercises.Count exercises
      <a asp-action="EditLesson" asp-route-id="@l.Id">Edit</a> |
      <a asp-action="Exercises" asp-route-lessonId="@l.Id">Exercises</a>
    </li>
  }
  </ul>
  <p><a asp-action="CreateLesson" asp-route-sectionId="@s.Id">Add lesson</a> | <a asp-action="Lessons" asp-route-sectionId="@s.Id">All lessons</a></p>
}
