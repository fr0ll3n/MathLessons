@model List<MathematicsLessons.Controllers.BillingRow>
@{ ViewData["Title"] = "Billing history"; }
<h1 class="h3 mb-3">Billing history</h1>
<p class="text-muted">Current plan: <strong>@ViewBag.Plan</strong></p>
<table class="table">
    <thead><tr><th>Date</th><th>Kind</th><th>Description</th><th>Amount</th><th>Status</th></tr></thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr>
            <td>@r.Date.ToLocalTime().ToString("dd MMM yyyy")</td>
            <td>@r.Kind</td>
            <td>@r.Description</td>
            <td>@r.Amount.ToString("0.00") BGN</td>
            <td>@r.Status</td>
        </tr>
    }
    </tbody>
</table>
@if (!Model.Any()) { <p class="text-muted">No payments yet. Book a session or subscribe to see receipts here.</p> }
