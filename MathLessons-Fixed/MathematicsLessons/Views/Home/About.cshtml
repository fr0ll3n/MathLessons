@{
    ViewData["Title"] = "About";
}

<div class="card-soft p-4 mx-auto" style="max-width:720px">
    <h1 class="h3">About Mathematics Lessons</h1>
    <p>
        This is a full-featured online mathematics learning platform built as a
        <strong>12th-grade diploma project</strong>. It combines classroom content,
        community, live help and private tutoring in one place.
    </p>
    <h2 class="h5 mt-4">Core features</h2>
    <ul>
        <li>Six progressive levels (Beginner → University Part 3) with sequential unlocks</li>
        <li>Video lessons + practice exercises + automatic progress tracking</li>
        <li>Private session booking with calendar, duration options and pricing</li>
        <li>Community feed, help chat rooms and weekly public Q&A sessions</li>
    </ul>
    <h2 class="h5 mt-4">Extra functions (for evaluation)</h2>
    <ol>
        <li><strong>Points & Leaderboard</strong> – earn points for lessons and exercises; compete on the ranking</li>
        <li><strong>Learning Streak</strong> – consecutive activity days tracked on profile</li>
        <li><strong>Certificates</strong> – automatic certificate + bonus points when a level reaches 100%</li>
        <li><strong>Teacher Dashboard</strong> – overview of students, missing videos and upcoming bookings</li>
        <li><strong>Dark mode</strong> – persistent theme toggle</li>
        <li><strong>Session ratings</strong> – students rate private sessions after completion</li>
        <li><strong>Community search & categories</strong> – filter and search the feed</li>
    </ol>
    <p class="text-muted small mt-4 mb-0">
        Demo accounts: <code>teacher@mathlessons.school</code> / Teacher123! ·
        <code>student@mathlessons.school</code> / Student123!
    </p>
</div>
