@model MathematicsLessons.Models.LessonPage
@{
    ViewData["Title"] = Model.Lesson.Title;
    var isStaff = User.IsInRole("Teacher") || User.IsInRole("Admin");
    var showExercises = Model.CanPractice || (Model.VideoWatched && !Model.ExercisesPassed);
}
<a class="course-back" asp-action="Level" asp-route-id="@Model.Lesson.LevelId">← Back to course</a>
<h1 class="page-title">@Model.Lesson.Title</h1>
<p class="page-lead">@Model.Lesson.Topic?.Name</p>

<div class="row">
    <div class="col-lg-8 mb-3">
        @if (!string.IsNullOrEmpty(Model.Lesson.Video))
        {
            <video id="lessonVideo" class="w-100 rounded" style="max-height:480px;background:#000" controls
                   src="@Model.Lesson.Video"
                   @(Model.VideoWatched ? "" : "")></video>
        }
        else
        {
            <div class="alert alert-secondary">No video uploaded yet.</div>
        }

        <div class="mt-3" style="white-space:pre-line">@Model.Lesson.Content</div>

        @* —— Exercises block: only after video watched —— *@
        @if ((Model.IsUnlocked || isStaff) && showExercises)
        {
            <div id="exercisePanel" class="card mt-4">
                <div class="card-body">
                    <h2 class="h5">Exercises</h2>
                    <p class="small text-muted">Finish these to unlock the next lesson. Wrong answers → watch the video again.</p>

                    <form asp-action="SubmitExercises" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Lesson.Id" />

                        @if (Model.Exercises == null || !Model.Exercises.Any())
                        {
                            <p class="text-muted">No questions for this lesson — submit to mark it complete.</p>
                        }
                        else
                        {
                            var i = 0;
                            foreach (var ex in Model.Exercises)
                            {
                                <div class="form-group">
                                    <label class="font-weight-bold">@(i + 1). @ex.Question</label>
                                    <input type="text" name="answers[@i]" class="form-control" required autocomplete="off" />
                                    @if (!string.IsNullOrEmpty(ex.Hint))
                                    {
                                        <small class="form-text text-muted">Hint: @ex.Hint</small>
                                    }
                                </div>
                                i++;
                            }
                        }

                        <button type="submit" class="btn btn-primary mt-2">Check answers</button>
                    </form>
                </div>
            </div>
        }
        else if ((Model.IsUnlocked || isStaff) && !Model.VideoWatched && !isStaff)
        {
            <p class="small text-muted mt-3">Watch the video to the end — exercises will appear below.</p>
            <form id="watchedForm" asp-action="MarkVideoWatched" method="post" class="d-none">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Lesson.Id" />
            </form>
        }
        else if (Model.ExercisesPassed)
        {
            <div class="alert alert-success mt-3">
                Lesson complete. The next lesson is unlocked.
            </div>
            <a class="btn btn-primary" asp-action="Level" asp-route-id="@Model.Lesson.LevelId">Back to course</a>
            @if (Model.NextLesson != null)
            {
                <a class="btn btn-outline-secondary ml-2" asp-action="Lesson" asp-route-id="@Model.NextLesson.Id">Next lesson</a>
            }
        }
    </div>

    <div class="col-lg-4">
        @if (Model.CanUpload)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="h6">Video (Teacher / Admin)</h2>
                    @if (!string.IsNullOrEmpty(Model.Lesson.Video))
                    {
                        <form asp-action="RemoveVideo" method="post" class="mb-2" onsubmit="return confirm('Remove video?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Lesson.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Remove video</button>
                        </form>
                    }
                    <form asp-action="Upload" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Lesson.Id" />
                        <input type="file" name="video" accept="video/*" class="form-control-file mb-2" required />
                        <button type="submit" class="btn btn-primary btn-sm btn-block">Upload / Replace</button>
                    </form>
                </div>
            </div>
        }

        <div class="card">
            <div class="card-body small text-muted">
                <div>Progress: @(Model.WatchedPercent)%</div>
                <div>Video: @(Model.VideoWatched ? "watched" : "not finished")</div>
                <div>Exercises: @(Model.ExercisesPassed ? "passed" : "pending")</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
  var v = document.getElementById('lessonVideo');
  var form = document.getElementById('watchedForm');
  if (!v || !form) return;
  v.addEventListener('ended', function () {
    form.submit();
  });
})();
</script>
}
