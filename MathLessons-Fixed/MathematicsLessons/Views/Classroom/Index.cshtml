@model MathematicsLessons.Models.ClassroomPage
@{
    ViewData["Title"] = "Курсове";
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h1 class="h3 fw-bold mb-1">Курсове по математика</h1>
        <p class="text-muted mb-0 small">
            @if (Model.IsSubscribed)
            {
                <span>Напредък: @Model.TotalCompleted / @Model.TotalLessons урока</span>
            }
            else
            {
                <span>Free: само първият Beginner урок. Math Enthusiast отключва всички.</span>
            }
        </p>
    </div>
    @if (!Model.IsSubscribed)
    {
        <a class="btn btn-primary" asp-controller="Subscription" asp-action="Plans">Math Enthusiast</a>
    }
</div>

<div class="row g-3">
@foreach (var block in Model.Levels)
{
    var locked = !block.IsUnlocked;
    var accent = block.Level.SortOrder switch { 1 => "success", 2 => "primary", 3 => "warning", _ => "danger" };
    <div class="col-md-6 col-lg-3">
        <a asp-action="Level" asp-route-id="@block.Level.Id" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 course-card @(locked ? "opacity-75" : "")">
                <div class="card-body p-4">
                    <span class="badge bg-@accent mb-2">@block.Level.Name</span>
                    @if (locked) { <i class="bi bi-lock-fill text-muted float-end"></i> }
                    <div class="small text-muted mb-2">@block.Level.GradeRange</div>
                    <p class="small mb-3" style="min-height:3rem">@block.Level.Description</p>
                    <div class="progress mb-2" style="height:6px">
                        <div class="progress-bar" style="width:@(block.Percent)%"></div>
                    </div>
                    <div class="d-flex justify-content-between small text-muted">
                        <span>@block.Completed / @block.Total урока</span>
                        @if (block.HasCertificate) { <span class="text-success"><i class="bi bi-award"></i></span> }
                    </div>
                </div>
            </div>
        </a>
    </div>
}
</div>
