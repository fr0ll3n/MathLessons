@model List<MathematicsLessons.Infrastructure.Data.Entities.AppointmentPlan>
@{ ViewData["Title"] = "Сесии"; }
<h1 class="h4">Цени 1h / 1.5h / 2h</h1>
<table class="table table-sm bg-white shadow-sm">
@foreach (var p in Model)
{
  <tr>
    <td>@p.Name</td><td>@p.DurationMinutes мин</td><td>@p.Price.ToString("0.00") лв</td>
    <td>
      <form asp-action="DeleteSessionPlan" method="post">@Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@p.Id" />
        <button type="submit" class="btn btn-sm btn-outline-danger">Изтрий</button>
      </form>
    </td>
  </tr>
}
</table>
<form asp-action="SaveSessionPlan" method="post" class="card border-0 shadow-sm p-3" style="max-width:400px">
  @Html.AntiForgeryToken()
  <input type="hidden" name="Id" value="0" />
  <input name="Name" class="form-control mb-2" placeholder="Name" required />
  <input name="DurationMinutes" type="number" class="form-control mb-2" placeholder="Minutes" required />
  <input name="Price" type="number" step="0.01" class="form-control mb-2" placeholder="Price" required />
  <input name="Description" class="form-control mb-2" placeholder="Description" />
  <button type="submit" class="btn btn-primary">Добави</button>
</form>
<a asp-action="Index">← Назад</a>
