@model List<MathematicsLessons.Controllers.AdminUserRow>
@{ ViewData["Title"] = "Потребители"; }
<h1 class="h4 fw-bold mb-3">Потребители и роли</h1>

<div class="card border-0 shadow-sm p-3 mb-4">
  <h2 class="h6">Направи Teacher по email</h2>
  <form asp-action="MakeTeacherByEmail" method="post" class="row g-2 align-items-end">
    @Html.AntiForgeryToken()
    <div class="col-md-8">
      <label class="form-label small">Email на регистриран потребител</label>
      <input name="email" type="email" class="form-control" placeholder="teacher@email.com" required />
    </div>
    <div class="col-md-4">
      <button type="submit" class="btn btn-primary w-100">Задай Teacher</button>
    </div>
  </form>
</div>

<form method="get" class="mb-3 d-flex gap-2">
  <input name="q" value="@ViewBag.Search" class="form-control" style="max-width:16rem" placeholder="email / име" />
  <button class="btn btn-outline-primary" type="submit">Търси</button>
</form>
<div class="table-responsive">
<table class="table table-sm table-hover">
<thead><tr><th>Email</th><th>Име</th><th>План</th><th>Роли</th><th></th></tr></thead>
<tbody>
@foreach (var r in Model)
{
  <tr>
    <td>@r.User.Email</td>
    <td>@r.User.FirstName @r.User.LastName</td>
    <td>@(r.User.Sub?.Type ?? "Free")</td>
    <td>@r.Roles</td>
    <td class="text-nowrap">
      @if (!r.IsTeacher)
      {
        <form asp-action="MakeTeacher" method="post" class="d-inline">@Html.AntiForgeryToken()
          <input type="hidden" name="id" value="@r.User.Id" />
          <button type="submit" class="btn btn-sm btn-primary">Teacher</button>
        </form>
      }
      else
      {
        <form asp-action="RemoveTeacher" method="post" class="d-inline">@Html.AntiForgeryToken()
          <input type="hidden" name="id" value="@r.User.Id" />
          <button type="submit" class="btn btn-sm btn-outline-secondary">Махни Teacher</button>
        </form>
      }
      @if (!r.IsAdmin)
      {
        <form asp-action="MakeAdmin" method="post" class="d-inline">@Html.AntiForgeryToken()
          <input type="hidden" name="id" value="@r.User.Id" />
          <button type="submit" class="btn btn-sm btn-warning">Admin</button>
        </form>
      }
    </td>
  </tr>
}
</tbody>
</table>
</div>
<a asp-action="Index">← Админ</a>
