@model MathematicsLessons.Controllers.AdminStatsVm
@{ ViewData["Title"] = "Админ панел"; }
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
  <div>
    <h1 class="h3 fw-bold mb-0"><i class="bi bi-shield-lock text-primary"></i> Админ панел</h1>
    <p class="text-muted small mb-0">Виждаш това само с роля <strong>Admin</strong> (OwnerEmail).</p>
  </div>
</div>

<div class="row g-3 mb-4">
</div>
</div>

<form asp-action="LoadDemoCourses" method="post" class="mb-3" onsubmit="return confirm('Load demo courses only if empty?');">
  @Html.AntiForgeryToken()
  <button type="submit" class="btn btn-primary">Load demo courses</button>
</form>
<h2 class="h6 text-muted text-uppercase mb-3">Админ действия (само за теб)</h2>
<div class="row g-3">
  <div class="col-md-4">
    <a asp-action="Users" class="card border-0 shadow-sm p-4 h-100 text-decoration-none admin-action-card">
      <div class="fs-3 text-primary mb-2"><i class="bi bi-people"></i></div>
      <div class="fw-bold text-body">Потребители / Teachers</div>
      <div class="small text-muted">Направи Teacher по email, Admin роли</div>
    </a>
  </div>
  <div class="col-md-4">
    <a asp-action="Plans" class="card border-0 shadow-sm p-4 h-100 text-decoration-none admin-action-card">
      <div class="fs-3 text-primary mb-2"><i class="bi bi-credit-card"></i></div>
      <div class="fw-bold text-body">Цена Math Enthusiast</div>
      <div class="small text-muted">Месечна / годишна цена</div>
    </a>
  </div>
  <div class="col-md-4">
    <a asp-action="SessionPlans" class="card border-0 shadow-sm p-4 h-100 text-decoration-none admin-action-card">
      <div class="fs-3 text-primary mb-2"><i class="bi bi-clock"></i></div>
      <div class="fw-bold text-body">1h / 1.5h / 2h</div>
      <div class="small text-muted">Цени за частни уроци</div>
    </a>
  </div>
  <div class="col-md-4">
    <a asp-action="PublicSessions" class="card border-0 shadow-sm p-4 h-100 text-decoration-none admin-action-card">
      <div class="fs-3 text-primary mb-2"><i class="bi bi-discord"></i></div>
      <div class="fw-bold text-body">Discord сесии</div>
      <div class="small text-muted">Публични Q&amp;A</div>
    </a>
  </div>
  <div class="col-md-4">
    <a asp-action="Bookings" class="card border-0 shadow-sm p-4 h-100 text-decoration-none admin-action-card">
      <div class="fs-3 text-primary mb-2"><i class="bi bi-calendar-check"></i></div>
      <div class="fw-bold text-body">Всички резервации</div>
      <div class="small text-muted">Частни уроци</div>
    </a>
  </div>
  <div class="col-md-4">
    <a asp-action="Donations" class="card border-0 shadow-sm p-4 h-100 text-decoration-none admin-action-card">
      <div class="fs-3 text-primary mb-2"><i class="bi bi-heart"></i></div>
      <div class="fw-bold text-body">Дарения</div>
      <div class="small text-muted">Списък и суми</div>
    </a>
  </div>
  <div class="col-md-4">
    <a asp-controller="CourseAdmin" asp-action="Index" class="card border-0 shadow-sm p-4 h-100 text-decoration-none admin-action-card">
      <div class="fs-3 text-success mb-2"><i class="bi bi-collection-play"></i></div>
      <div class="fw-bold text-body">Курсове CRUD</div>
      <div class="small text-muted">Уроци, видеа, упражнения</div>
    </a>
  </div>
</div>
<style>
.admin-action-card { transition: transform .12s, box-shadow .12s; color: inherit; }
.admin-action-card:hover { transform: translateY(-3px); box-shadow: 0 12px 28px rgba(0,0,0,.12) !important; }
</style>
