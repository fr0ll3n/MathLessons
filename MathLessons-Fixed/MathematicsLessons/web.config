<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- ~2 GB per request; total video library limited by disk (~70 GB target) -->
        <requestLimits maxAllowedContentLength="107374182400" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
